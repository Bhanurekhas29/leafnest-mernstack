PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leafnest
# Set to true for TiDB Cloud / hosted MySQL that requires TLS
DB_SSL=false

JWT_SECRET=change-this-secret

# First admin account, created automatically on first start
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@leafnest.in
ADMIN_PASSWORD=change-me-now

# Optional SMTP for the forgot-password email. If empty, the reset link is printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Leafnest Admin <no-reply@leafnest.in>
